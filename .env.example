# Public site URL (used for metadata, sitemap and robots). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# --- Reviews (Supabase) ---------------------------------------------------
# Server-only. Use the project URL and the *anon* (public) key.
# Never put the service-role key in this project.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Contact form (Resend) ------------------------------------------------
# Server-only. Used by the contact form AND by the AI assistant's "email Cyrus" feature.
# Only RESEND_API_KEY is required. Without it, nothing is sent and the site says so.
RESEND_API_KEY=
# Optional. Default: cyrusakacha@gmail.com
CONTACT_TO_EMAIL=
# Optional. Default: Portfolio <onboarding@resend.dev>. That sender only delivers to the email address of your
# own Resend account, so sign up to Resend with cyrusakacha@gmail.com, or verify a domain and use it here.
CONTACT_FROM_EMAIL=

# --- AI assistant (OpenRouter) --------------------------------------------
# Server-only. Without a key the floating assistant says it is not switched on
# and shows your email and phone instead.
OPENROUTER_API_KEY=
# Optional. Defaults to openai/gpt-4o-mini.
OPENROUTER_MODEL=
