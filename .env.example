# Public site URL (used for metadata, sitemap and robots). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# --- Reviews (Supabase) ---------------------------------------------------
# Server-only. Use the project URL and the *anon* (public) key.
# Never put the service-role key in this project.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Contact form (Resend) ------------------------------------------------
# Server-only. Leave empty to keep the form honest about being unconfigured.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# --- AI assistant (OpenRouter) --------------------------------------------
# Server-only. Without a key the floating assistant says it is not switched on
# and shows your email and phone instead.
OPENROUTER_API_KEY=
# Optional. Defaults to openai/gpt-4o-mini.
OPENROUTER_MODEL=
